{
  "name": "super-agents",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @super-agents/api dev",
    "dev:api:worker": "pnpm --filter @super-agents/api dev:worker",
    "db:upgrade": "pnpm --filter @super-agents/api exec tsx scripts/upgrade-dev-db.mjs",
    "dev:web": "pnpm --filter @super-agents/web dev",
    "build": "turbo build",
    "build:api": "pnpm --filter @super-agents/api build",
    "build:web": "pnpm --filter @super-agents/web build",
    "start": "pnpm --filter @super-agents/web start",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:fix": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check . --write",
    "typecheck": "turbo typecheck && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:all": "scripts/e2e-postgres.sh up && pnpm build && E2E_POSTGREST_URL=http://127.0.0.1:3001 playwright test",
    "test:e2e:postgres": "scripts/e2e-postgres.sh",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "verify:worker": "./scripts/check-worker-runtime.sh",
    "verify:container": "./scripts/check-container-image.sh",
    "deploy:api": "pnpm --filter @super-agents/api deploy"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/types": "^3.974.5",
    "@dicebear/collection": "^9.4.3",
    "@dicebear/core": "^9.4.3",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@smithy/signature-v4": "^5.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
