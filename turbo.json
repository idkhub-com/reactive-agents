{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "format": {},
    "format:fix": {
      "cache": false
    },
    "check": {},
    "check:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // Turborepo 2 filters the environment by default. Without this a
      // `PORT=... pnpm dev` or `LIBSQL_URL= pnpm dev` is silently ignored and
      // the task runs with the defaults instead.
      "passThroughEnv": [
        "PORT",
        "LIBSQL_URL",
        "LIBSQL_AUTH_TOKEN",
        "ACCESS_PASSWORD",
        "BEARER_TOKEN",
        "API_URL"
      ]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  }
}
