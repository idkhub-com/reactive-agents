{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@web/*": ["./packages/web/src/*"],
      "@api/*": ["./packages/api/src/*"],
      "@shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "**/node_modules/**"]
}
